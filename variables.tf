variable "create" {
  description = "Controls whether any resources are created by this module"
  type        = bool
  default     = true
}

variable "bucket" {
  description = "Name of the bucket. Conflicts with `bucket_prefix`"
  type        = string
  default     = null
}

variable "bucket_prefix" {
  description = "Prefix for a generated bucket name. Conflicts with `bucket`"
  type        = string
  default     = null
}

variable "force_destroy" {
  description = "Whether all objects, including locked ones, are deleted so that the bucket can be destroyed"
  type        = bool
  default     = false
}

variable "object_lock_enabled" {
  description = "Whether S3 Object Lock is enabled. Can only be set when the bucket is created"
  type        = bool
  default     = false
}

variable "block_public_access" {
  description = "Whether all four S3 Block Public Access settings are enabled"
  type        = bool
  default     = true
}

variable "object_ownership" {
  description = "Object ownership: `BucketOwnerEnforced` (ACLs disabled), `BucketOwnerPreferred` or `ObjectWriter`"
  type        = string
  default     = "BucketOwnerEnforced"
}

variable "versioning_enabled" {
  description = "Whether object versioning is enabled"
  type        = bool
  default     = true
}

variable "sse_algorithm" {
  description = "Server-side encryption algorithm: `AES256` or `aws:kms`"
  type        = string
  default     = "AES256"

  validation {
    condition     = contains(["AES256", "aws:kms", "aws:kms:dsse"], var.sse_algorithm)
    error_message = "sse_algorithm must be AES256, aws:kms or aws:kms:dsse."
  }
}

variable "kms_master_key_id" {
  description = "ARN of the KMS key used when `sse_algorithm` is `aws:kms`. Uses the AWS-managed `aws/s3` key when null"
  type        = string
  default     = null
}

variable "bucket_key_enabled" {
  description = "Whether S3 Bucket Keys reduce KMS request costs. Only meaningful with `aws:kms`"
  type        = bool
  default     = true
}

variable "attach_deny_insecure_transport_policy" {
  description = "Whether to attach a statement that denies requests that do not use TLS"
  type        = bool
  default     = true
}

variable "policy" {
  description = "Additional JSON bucket policy that is merged with the policies generated by this module"
  type        = string
  default     = null
}

variable "logging" {
  description = "Server access logging. `target_bucket` receives the logs under `target_prefix`"
  type = object({
    target_bucket = string
    target_prefix = optional(string, "logs/")
  })
  default = null
}

variable "lifecycle_rules" {
  description = "Map of lifecycle rules keyed by rule ID"
  type = map(object({
    enabled = optional(bool, true)
    prefix  = optional(string, "")
    transitions = optional(list(object({
      days          = number
      storage_class = string
    })), [])
    expiration_days                        = optional(number)
    noncurrent_version_expiration_days     = optional(number)
    abort_incomplete_multipart_upload_days = optional(number, 7)
  }))
  default = {}
}

variable "tags" {
  description = "Tags applied to all resources"
  type        = map(string)
  default     = {}
}
